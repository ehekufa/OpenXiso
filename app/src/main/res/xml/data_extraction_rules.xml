<?xml version="1.0" encoding="utf-8"?>
<!-- Правила переноса данных для Android 12+: локальные настройки не экспортируются. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
