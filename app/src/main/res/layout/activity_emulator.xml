<?xml version="1.0" encoding="utf-8"?>
<!-- Экран настоящего эмулятора: VGA-текст 80x25, журнал POST и клавиатура BIOS. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emulatorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/console_background"
    android:orientation="vertical">

    <!-- Заголовок: белый текст на глубоком Google Blue. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/emulatorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emulator_title"
            android:textColor="@color/console_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emulatorFirmware"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/emulator_subtitle"
            android:textColor="@color/console_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/console_outline" />

    <!-- Экран 80x25: моноширинный шрифт, прокрутка по обеим осям. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/console_background"
        android:fillViewport="true"
        android:padding="12dp">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/emulatorScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/emulator_screen_description"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.0"
                android:textColor="@color/console_text"
                android:textSize="11sp"
                android:typeface="monospace" />
        </ScrollView>
    </HorizontalScrollView>

    <!-- Состояние ЦПУ и счётчик реально исполненных инструкций. -->
    <TextView
        android:id="@+id/emulatorStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/console_surface"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp"
        android:textColor="@color/console_text"
        android:textSize="12sp" />

    <!-- Журнал POST, INT 13h и остальных сервисов собственного BIOS. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/console_background"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emulator_log_label"
                android:textColor="@color/console_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/emulatorLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/console_dim"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Клавиатура: символы уходят в очередь INT 16h собственного BIOS. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/console_surface"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/emulatorKeyInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_console_field"
            android:hint="@string/emulator_input_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/console_text"
            android:textColorHint="@color/console_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/emulatorSendButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_console_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/emulator_action_send"
            android:textAllCaps="false"
            android:textColor="@color/console_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Управление циклом исполнения. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/console_background"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/emulatorPauseButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_console_button"
            android:text="@string/emulator_action_pause"
            android:textAllCaps="false"
            android:textColor="@color/console_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/emulatorStopButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_console_button"
            android:text="@string/emulator_action_stop"
            android:textAllCaps="false"
            android:textColor="@color/console_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
